# {{ ansible_managed }}
[Unit]
Description=VM relay {{ item.name }} proxy to {{ item.target }}
Requires=vm-relay-{{ item.name }}.socket
After=vm-relay-{{ item.name }}.socket

[Service]
ExecStart=/usr/lib/systemd/systemd-socket-proxyd --connections-max={{ item.max_conns | default(64) }} {{ item.target }}
DynamicUser=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallFilter=@system-service
# Only the relay client and target may talk to this process.
IPAddressDeny=any
IPAddressAllow={{ [item.allow_from] | flatten | join(' ') }} {{ item.target.split(":")[0] }}
