{
  "uid": "homelab-postgres",
  "title": "Postgres",
  "tags": [
    "homelab",
    "infra",
    "database"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 39,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "homelab"
      ],
      "asDropdown": true,
      "title": "Homelab",
      "includeVars": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prom"
        },
        "query": {
          "query": "label_values(pg_up{job=\"integrations/postgres\"}, host_name)",
          "refId": "h"
        },
        "refresh": 2,
        "current": {}
      },
      {
        "name": "db",
        "label": "Database",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prom"
        },
        "query": {
          "query": "label_values(pg_stat_database_xact_commit{host_name=\"$host\", datname!~\"template.*|postgres\"}, datname)",
          "refId": "d"
        },
        "refresh": 2,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Up",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": null,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(pg_up{job=\"integrations/postgres\", host_name=\"$host\"})",
          "instant": false,
          "range": true
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 3,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Transactions / s",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pg_stat_database_xact_commit{job=\"integrations/postgres\", host_name=\"$host\", datname=\"$db\"}[5m]) + rate(pg_stat_database_xact_rollback{job=\"integrations/postgres\", host_name=\"$host\", datname=\"$db\"}[5m]))",
          "instant": false,
          "range": true
        }
      ],
      "id": 3,
      "gridPos": {
        "x": 3,
        "y": 1,
        "w": 3,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Connections",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": null,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 500
              },
              {
                "color": "red",
                "value": 800
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pg_stat_database_numbackends{job=\"integrations/postgres\", host_name=\"$host\"})",
          "instant": false,
          "range": true
        }
      ],
      "description": "All databases; max_connections is 1000.",
      "id": 4,
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 3,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Cache hit",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.95
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pg_stat_database_blks_hit{job=\"integrations/postgres\", host_name=\"$host\", datname=\"$db\"}[15m])) / clamp_min(sum(rate(pg_stat_database_blks_hit{job=\"integrations/postgres\", host_name=\"$host\", datname=\"$db\"}[15m])) + sum(rate(pg_stat_database_blks_read{job=\"integrations/postgres\", host_name=\"$host\", datname=\"$db\"}[15m])), 1e-9)",
          "instant": false,
          "range": true
        }
      ],
      "description": "Share of block reads served from shared_buffers (reads that miss may still hit the OS page cache).",
      "id": 5,
      "gridPos": {
        "x": 9,
        "y": 1,
        "w": 3,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Database size",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": null,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(pg_database_size_bytes{job=\"integrations/postgres\", host_name=\"$host\", datname=\"$db\"})",
          "instant": false,
          "range": true
        }
      ],
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 3,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Longest open transaction",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": null,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 300
              },
              {
                "color": "red",
                "value": 1800
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(pg_stat_activity_max_tx_duration{job=\"integrations/postgres\", host_name=\"$host\"})",
          "instant": false,
          "range": true
        }
      ],
      "description": "Long transactions hold back vacuum and bloat tables.",
      "id": 7,
      "gridPos": {
        "x": 15,
        "y": 1,
        "w": 3,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Deadlocks (24 h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": null,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(pg_stat_database_deadlocks{job=\"integrations/postgres\", host_name=\"$host\", datname=\"$db\"}[24h]))",
          "instant": false,
          "range": true
        }
      ],
      "id": 8,
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 3,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Uptime",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": null,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max(pg_postmaster_start_time_seconds{job=\"integrations/postgres\", host_name=\"$host\"})",
          "instant": false,
          "range": true
        }
      ],
      "id": 9,
      "gridPos": {
        "x": 21,
        "y": 1,
        "w": 3,
        "h": 4
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Activity",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Connections by state and user",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state, usename) (pg_stat_activity_count{job=\"integrations/postgres\", host_name=\"$host\", datname=\"$db\"}) > 0",
          "legendFormat": "{{usename}} {{state}}",
          "range": true
        }
      ],
      "description": "Roles: user = dev1's app, workers and scheduler; exampleapp_web = web1.",
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Transactions / s",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pg_stat_database_xact_commit{job=\"integrations/postgres\", host_name=\"$host\", datname=\"$db\"}[$__rate_interval]))",
          "legendFormat": "commit",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(rate(pg_stat_database_xact_rollback{job=\"integrations/postgres\", host_name=\"$host\", datname=\"$db\"}[$__rate_interval]))",
          "legendFormat": "rollback",
          "range": true
        }
      ],
      "id": 12,
      "gridPos": {
        "x": 8,
        "y": 6,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Rows / s",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pg_stat_database_tup_returned{job=\"integrations/postgres\", host_name=\"$host\", datname=\"$db\"}[$__rate_interval]))",
          "legendFormat": "returned (scanned)",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(rate(pg_stat_database_tup_fetched{job=\"integrations/postgres\", host_name=\"$host\", datname=\"$db\"}[$__rate_interval]))",
          "legendFormat": "fetched (by index)",
          "range": true
        },
        {
          "refId": "C",
          "expr": "sum(rate(pg_stat_database_tup_inserted{job=\"integrations/postgres\", host_name=\"$host\", datname=\"$db\"}[$__rate_interval]))",
          "legendFormat": "inserted",
          "range": true
        },
        {
          "refId": "D",
          "expr": "sum(rate(pg_stat_database_tup_updated{job=\"integrations/postgres\", host_name=\"$host\", datname=\"$db\"}[$__rate_interval]))",
          "legendFormat": "updated",
          "range": true
        },
        {
          "refId": "E",
          "expr": "sum(rate(pg_stat_database_tup_deleted{job=\"integrations/postgres\", host_name=\"$host\", datname=\"$db\"}[$__rate_interval]))",
          "legendFormat": "deleted",
          "range": true
        }
      ],
      "description": "returned far above fetched means sequential scans (see Tables).",
      "id": 13,
      "gridPos": {
        "x": 16,
        "y": 6,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 14,
      "type": "row",
      "title": "Queries (pg_stat_statements, top 50 by total time)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Time spent by query (top 10)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (queryid) (rate(pg_stat_statements_seconds_total{job=\"integrations/postgres\", host_name=\"$host\", datname=\"$db\"}[$__rate_interval]))) * on (queryid) group_left(query) max by (queryid, query) (pg_stat_statements_query_id{job=\"integrations/postgres\", host_name=\"$host\"})",
          "legendFormat": "{{query}}",
          "range": true
        }
      ],
      "description": "Seconds of execution per second (1 = one backend busy all the time).",
      "id": 15,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "Statements (last 1 h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queryid, user) (increase(pg_stat_statements_seconds_total{job=\"integrations/postgres\", host_name=\"$host\", datname=\"$db\"}[1h])) * on (queryid) group_left(query) max by (queryid, query) (pg_stat_statements_query_id{job=\"integrations/postgres\", host_name=\"$host\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "sum by (queryid, user) (increase(pg_stat_statements_calls_total{job=\"integrations/postgres\", host_name=\"$host\", datname=\"$db\"}[1h]))",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "1000 * sum by (queryid, user) (increase(pg_stat_statements_seconds_total{job=\"integrations/postgres\", host_name=\"$host\", datname=\"$db\"}[1h])) / clamp_min(sum by (queryid, user) (increase(pg_stat_statements_calls_total{job=\"integrations/postgres\", host_name=\"$host\", datname=\"$db\"}[1h])), 1)",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "sum by (queryid, user) (increase(pg_stat_statements_rows_total{job=\"integrations/postgres\", host_name=\"$host\", datname=\"$db\"}[1h]))",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "E",
          "expr": "sum by (queryid, user) (increase(pg_stat_statements_block_read_seconds_total{job=\"integrations/postgres\", host_name=\"$host\", datname=\"$db\"}[1h]))",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge"
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "user": 0,
              "query": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5,
              "Value #E": 6
            },
            "renameByName": {
              "user": "Role",
              "query": "Query",
              "Value #A": "Total time",
              "Value #B": "Calls",
              "Value #C": "Mean ms",
              "Value #D": "Rows",
              "Value #E": "Read I/O time"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Total time",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Total time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Read I/O time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Mean ms"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          }
        ]
      },
      "description": "queryid is hidden; the text is the first 150 characters. Read I/O time needs track_io_timing.",
      "id": 16,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 10
      }
    },
    {
      "id": 17,
      "type": "row",
      "title": "I/O and checkpoints",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Blocks / s",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pg_stat_database_blks_hit{job=\"integrations/postgres\", host_name=\"$host\", datname=\"$db\"}[$__rate_interval]))",
          "legendFormat": "hit (shared_buffers)",
          "range": true
        },
        {
