# {{ ansible_managed }} (roles/postgres_server)
[global]
repo1-path={{ pg_backup_mount }}/repo
repo1-retention-full={{ pgbackrest_retention_full }}
repo1-retention-full-type=count
{% if pgbackrest_repo2 is defined %}
repo2-type=sftp
repo2-path={{ pgbackrest_repo2.path }}
repo2-sftp-host={{ pgbackrest_repo2.host }}
repo2-sftp-host-port={{ pgbackrest_repo2.port }}
repo2-sftp-host-user={{ pgbackrest_repo2.user }}
repo2-sftp-private-key-file={{ pgbackrest_repo2.key }}
repo2-sftp-host-key-hash-type=sha256
repo2-sftp-host-key-check-type=fingerprint
repo2-sftp-host-fingerprint={{ pgbackrest_repo2.host_fingerprint }}
repo2-cipher-type=aes-256-cbc
repo2-cipher-pass={{ vault_pgbackrest_repo2_cipher_pass }}
repo2-bundle=y
repo2-block=y
repo2-retention-full={{ pgbackrest_repo2.retention_full }}
repo2-retention-full-type=count
{% endif %}
compress-type=zst
compress-level=3
process-max=4
start-fast=y
log-level-console=info
log-level-file=detail
archive-async=y
spool-path=/var/spool/pgbackrest

[{{ pg_database }}]
pg1-path=/var/lib/postgresql/{{ pg_version }}/{{ pg_cluster }}
